# ============================================================
# Mercovia — Docker Compose environment variables
# Copy this file to `.env` on the EC2 host and fill in real values.
# NEVER commit the real `.env` file.
# ============================================================

# ---- MongoDB (containerized, local to this host) -----------------
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=

# ---- JWT / session secrets ----------------------------------------
# REQUIRED now that NODE_ENV=production — generate with `openssl rand -hex 32`
ACCESS_TOKEN=
REFRESH_TOKEN=
JWT_SECRET_KEY=
JWT_EXPIRES=5
ACCESS_TOKEN_EXPIRE=2
REFRESH_TOKEN_EXPIRE=24

# REQUIRED now — generate with `openssl rand -hex 32`
ENCRYPTION_KEY=

# ---- Cloudinary (image uploads) ------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Stripe ---------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
COMPANY_NAME=Mercovia

# ---- SMTP / email ----------------------------------------------------
SMPT_HOST=
SMPT_PORT=587
SMTP_SERVICE=
SMTP_MAIL=
SMTP_PASSWORD=

# ---- Admin seed script ------------------------------------------------
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Public origins ----------------------------------------------------
PUBLIC_ORIGIN=https://mercovia.online
SOCKET_ORIGIN=https://socket.mercovia.online