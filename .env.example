# ============================================================
# Mercovia — Docker Compose environment variables
# Copy this file to `.env` in the repository root:
#   cp .env.example .env
# Then fill in real values. NEVER commit the real `.env` file.
# ============================================================

# ---- MongoDB ---------------------------------------------------
# REQUIRED — the server container will crash-loop without this.
# Reuse the same connection string from your existing server/.env
# (e.g. your MongoDB Atlas cluster).
MONGO_URI=

# ---- JWT / session secrets --------------------------------------
# Optional while testing (falls back to dev-only secrets because
# NODE_ENV=development is set in docker-compose.yml). Set real
# random values for realistic session testing.
ACCESS_TOKEN=
REFRESH_TOKEN=
JWT_SECRET_KEY=
JWT_EXPIRES=5
ACCESS_TOKEN_EXPIRE=2
REFRESH_TOKEN_EXPIRE=24

# Optional — encrypts seller bank account numbers. Falls back to a
# dev-only key when NODE_ENV=development.
ENCRYPTION_KEY=

# ---- Cloudinary (image uploads) ----------------------------------
# REQUIRED for signup, avatar upload, product/event image upload.
# Reuse the values from your existing server/.env.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Stripe -------------------------------------------------------
# STRIPE_SECRET_KEY is REQUIRED — the server crashes at startup
# without it (server/src/config/stripe.ts throws if missing).
# Use a TEST key (starts with sk_test_...), never a live key.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
COMPANY_NAME=Mercovia

# ---- SMTP / email (signup activation, password reset) -------------
# Optional for basic browsing/API testing. Required to test signup
# activation emails and password-reset emails end-to-end.
SMPT_HOST=
SMPT_PORT=587
SMTP_SERVICE=
SMTP_MAIL=
SMTP_PASSWORD=

# ---- Admin seed script (not required for `docker compose up`) -----
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- EC2 / reverse-proxy public origin --------------------------------
# The exact public URL the browser will use, no trailing slash.
# Example: http://3.91.123.45  (or https://yourdomain.com once you add TLS)
PUBLIC_ORIGIN=